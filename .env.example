# ─────────────────────────────────────────────────────────
# Recruitera V2 — environment template
# Copy to .env locally. Never commit real values.
# ─────────────────────────────────────────────────────────

# Public — bundled into client JS. Only for values safe to expose.
NUXT_PUBLIC_API_BASE=https://api.recruitera.ai
NUXT_PUBLIC_APP_ENV=development

# Private — server-only. Never prefix these with NUXT_PUBLIC_.
API_SECRET=your-server-side-secret-here
DATABASE_URL=postgresql://user:password@localhost:5432/recruitera
